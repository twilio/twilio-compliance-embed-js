{
  "name": "@twilio/twilio-compliance-embed-js",
  "version": "0.0.4",
  "description": "The official JavaScript SDK for Twilio Compliance Embed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twilio/twilio-compliance-embed-js.git"
  },
  "homepage": "https://github.com/twilio/twilio-compliance-embed-js#readme",
  "bugs": {
    "url": "https://github.com/twilio/twilio-compliance-embed-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/index.*"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "persona": "5.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.4.1",
    "jsdom": "^25.0.0",
    "persona": "5.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^5.0.5"
  }
}
